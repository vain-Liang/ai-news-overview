{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno task typecheck && deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "lint": "deno run -A npm:eslint src",
    "test": "deno test --allow-env --allow-net --allow-read tests/*.test.ts",
    "typecheck": "deno check --config deno.json src/main.tsx vite.config.ts tests/*.test.ts"
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@/": "./src/"
  },
  "lint": {
    "include": ["src", "tests", "vite.config.ts"]
  },
  "fmt": {
    "include": ["deno.json"],
    "exclude": ["dist", "node_modules"]
  },
  "exclude": ["dist", "node_modules"]
}
